# Monitored hosts (file_sd discovery).
#
# SECURITY: this is the server's local working file with real device names/IPs.
# The copy in the repo only contains placeholders - never commit real values.
#
# This is a REFERENCE generated by the bootstrap from the Devices/ registry
# (${PATH_TO_COMPOSE}/Automatization/Monitoring/Devices/<device>/.env, mounted
# read-only at /devices). Do not edit it by hand: the bootstrap regenerates it
# on every stack start. One block per device, the host label comes from DEVICE_NAME:
- targets:
    - "<device-address>:9100"
  labels:
    host: "<DEVICE_NAME>"