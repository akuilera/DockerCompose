PATH_TO_CONTAINERS=/path/to/containers/data
# Absolute path of the repository clone kept on the server: the bootstrap reads
# the device registry from ${PATH_TO_COMPOSE}/Automatization/Monitoring/Devices/
# (Portainer CE resolves absolute binds only; ./... from its git clone is empty).
PATH_TO_COMPOSE=/path/to/repository/clone
PATH_TO_SECRETS=/path/to/secrets

### Device registry (one <device>/.env per host).
# The registry is read by the bootstrap from
# ${PATH_TO_COMPOSE}/Automatization/Monitoring/Devices/, not from this file.
# Create it in the repository clone following the template in
# Automatization/Monitoring/Devices.example/example/.env.example
# (DEVICE_NAME, DEVICE_ADDR, DEVICE_BATTERY, DEVICE_GPU).
# Example:
#   ${PATH_TO_COMPOSE}/Automatization/Monitoring/Devices/<device>/.env
#     DEVICE_NAME="<device display name>"
#     DEVICE_ADDR=<ip>:9100
#     DEVICE_BATTERY=0
#     DEVICE_GPU=0