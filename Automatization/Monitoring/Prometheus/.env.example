PATH_TO_CONTAINERS=/path/to/containers/data
PATH_TO_SECRETS=/path/to/secrets

### Monitored hosts for the node job (file_sd), comma-separated "name=host:port".
# Use the "name=" prefix so the bootstrap sets labels.host=<name> on that target;
# that host label is what the dashboards (Monitoring + Grafana) filter on via the
# $host variable — without it you get "No data" even with the target UP.
# Plain host:port entries still work but get no host label.
NODE_TARGETS=server=node-exporter:9100,client-1=<host-client-1>:9100