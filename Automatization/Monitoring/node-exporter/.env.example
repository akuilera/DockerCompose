# node_exporter + host heartbeat -- installer settings.
#
# Copy to .env next to install-node-exporter.sh and edit. .env is gitignored and
# must stay that way: it is the only place a real value belongs.
#
# EVERY setting is optional. The defaults are the ones that work on a standard
# systemd Linux with a single NVIDIA GPU, and this file exists to document them
# rather than to be filled in. Nothing machine specific belongs here.
#
# Older installations know these settings as GPU_HEARTBEAT_*; the installer still
# reads those names as a fallback so a working .env keeps working, but everything
# new is spelled HOST_HEARTBEAT_* and only those are documented here.

# --- which version ----------------------------------------------------------
# Pinned on purpose: an unattended "latest" is how a monitoring agent breaks
# itself at 3am. Bump deliberately, after reading the release notes.
NODE_EXPORTER_VERSION=1.12.1

# --- paths ------------------------------------------------------------------
NODE_EXPORTER_INSTALL_DIR=/usr/local/bin
NODE_EXPORTER_UNIT_DIR=/etc/systemd/system
NODE_EXPORTER_STATE_DIR=/var/lib/node_exporter
# If you change this you must also change --collector.textfile.directory in
# node-exporter.service; the installer prints a warning if they disagree.
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# --- service account --------------------------------------------------------
NODE_EXPORTER_USER=node_exporter
NODE_EXPORTER_GROUP=node_exporter

# --- exporter settings ------------------------------------------------------
NODE_EXPORTER_LISTEN=:9100
# Keep the systemd collector on. It is what turns "the box froze" from a guess
# into a question with an answer, and it is the only way to see a failed unit.
NODE_EXPORTER_ENABLE_SYSTEMD_COLLECTOR=1
# Extra flags appended to ExecStart, e.g.
#   NODE_EXPORTER_OPTS_EXTRA=--collector.processes --web.external-url=http://host:9100
NODE_EXPORTER_OPTS_EXTRA=

# --- checksum verification --------------------------------------------------
# The checksum manifest is fetched from the same release as the tarball, so this
# catches corruption and truncation, not a compromised upstream. Set to 0 only if
# you have a reason to, and say why in a comment.
NODE_EXPORTER_VERIFY_SHA256=1

# --- host heartbeat ---------------------------------------------------------
# Installed unconditionally: the one thing it exists for -- noticing that the box
# was powered on while nothing ran on it -- depends on no hardware at all.
# 0 disables both the heartbeat and the GPU/journal sections.
HOST_HEARTBEAT_ENABLE=1
HOST_HEARTBEAT_INTERVAL=15s
# Only the GPU section is conditional, and auto means what it used to mean for the
# whole heartbeat: query nvidia-smi when it is there, and report node_gpu_present
# 0 when it is not. That is the normal case for the server running the stack.
# 1 forces the query, 0 skips it.
HOST_HEARTBEAT_GPU_ENABLE=auto
# nvidia-smi and journalctl are both wrapped in timeout(1). On a healthy machine
# nvidia-smi answers in well under a second, so 5s is generous; a lower value
# means a wedged GPU is reported sooner instead of delaying the next run.
HOST_HEARTBEAT_TIMEOUT=5
# A gap longer than this is an event worth recording. Must comfortably exceed
# HOST_HEARTBEAT_INTERVAL, or every ordinary scheduling hiccup becomes a freeze.
HOST_HEARTBEAT_GAP_THRESHOLD=60
# A gap longer than this is rejected as a corrupt stored value instead of being
# believed. 60 days: no real machine is ever legitimately missing for two months.
HOST_HEARTBEAT_SANITY_GAP=5184000
# How long a recorded hard freeze keeps raising GpuFreezeDetected, in seconds.
# 2592000 is 30 days. Set to 0 to latch forever until you clear the file by hand.
HOST_HEARTBEAT_MAX_GAP_TTL=2592000
# How long the classified event history is kept, in seconds. 2592000 is 30 days,
# which is the stated goal: an intermittent hang is only useful with a history to
# correlate it against. Bounded by a line cap as well, so a reboot loop cannot
# fill the disk.
HOST_HEARTBEAT_EVENT_RETENTION=2592000
HOST_HEARTBEAT_EVENT_MAX=5000
# Where host-heartbeat-sleep leaves its marker. systemd runs sleep hooks as root
# with no environment of its own, so the installer also writes /etc/default/
# host-heartbeat pointing at this path.
HOST_HEARTBEAT_MARKER_DIR=/var/lib/node_exporter/textfile_collector
HOST_HEARTBEAT_SLEEP_HOOK_DIR=/usr/lib/systemd/system-sleep
# How long the installer waits for the first heartbeat metric before reporting it
# missing. Must comfortably exceed HOST_HEARTBEAT_INTERVAL: the file has to be
# written and then scraped, so the wait is not one interval.
HOST_HEARTBEAT_WAIT=45
# Journal correlation. auto reads the kernel and LACT journals when journalctl is
# present, 1 forces it and 0 turns it off (node_journal_enabled 0). It is
# read-only and cheap, but it is a second journal read per timer tick.
HOST_HEARTBEAT_JOURNAL=auto
# How long a matched journal line keeps node_journal_event_recent at 1, in seconds.
HOST_HEARTBEAT_JOURNAL_RECENT=900

# --- firewall ---------------------------------------------------------------
# 1 opens the port with whichever per-port manager is actually active (firewalld
# or ufw) and changes nothing otherwise. Raw nftables/iptables rulesets are never
# edited, and no setting here can make an application firewall (Portmaster and
# similar) or an upstream router let the port through: the installer reports what
# it found and leaves the rest to you. Set to 0 if the port is already published.
NODE_EXPORTER_FIREWALL_MANAGE=1
NODE_EXPORTER_FIREWALL_PORT=9100/tcp