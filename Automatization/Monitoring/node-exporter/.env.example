# node_exporter + NVIDIA GPU heartbeat -- installer settings.
#
# Copy to .env next to install-node-exporter.sh and edit. .env is gitignored and
# must stay that way: it is the only place a real value belongs.
#
# EVERY setting is optional. The defaults are the ones that work on a standard
# systemd Linux with a single NVIDIA GPU, and this file exists to document them
# rather than to be filled in. Nothing machine specific belongs here.

# --- which version ----------------------------------------------------------
# Pinned on purpose: an unattended "latest" is how a monitoring agent breaks
# itself at 3am. Bump deliberately, after reading the release notes.
NODE_EXPORTER_VERSION=1.12.1

# --- paths ------------------------------------------------------------------
NODE_EXPORTER_INSTALL_DIR=/usr/local/bin
NODE_EXPORTER_UNIT_DIR=/etc/systemd/system
NODE_EXPORTER_STATE_DIR=/var/lib/node_exporter
# If you change this you must also change --collector.textfile.directory in
# node-exporter.service; the installer prints a warning if they disagree.
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# --- service account --------------------------------------------------------
NODE_EXPORTER_USER=node_exporter
NODE_EXPORTER_GROUP=node_exporter

# --- exporter settings ------------------------------------------------------
NODE_EXPORTER_LISTEN=:9100
# Keep the systemd collector on. It is what turns "the box froze" from a guess
# into a question with an answer, and it is the only way to see a failed unit.
NODE_EXPORTER_ENABLE_SYSTEMD_COLLECTOR=1
# Extra flags appended to ExecStart, e.g.
#   NODE_EXPORTER_OPTS_EXTRA=--collector.processes --web.external-url=http://host:9100
NODE_EXPORTER_OPTS_EXTRA=

# --- checksum verification --------------------------------------------------
# The checksum manifest is fetched from the same release as the tarball, so this
# catches corruption and truncation, not a compromised upstream. Set to 0 only if
# you have a reason to, and say why in a comment.
NODE_EXPORTER_VERIFY_SHA256=1

# --- NVIDIA GPU heartbeat ---------------------------------------------------
# auto installs the heartbeat only when nvidia-smi is on PATH, so a machine with
# no NVIDIA card does not get a timer whose only honest metric is
# node_gpu_present 0. That is the normal case for the server running the stack.
# Use 1 to force it on and 0 to force it off.
GPU_HEARTBEAT_ENABLE=auto
GPU_HEARTBEAT_INTERVAL=15s
# nvidia-smi is wrapped in timeout(1). On a healthy machine it answers in well
# under a second, so 5s is generous; a lower value means a wedged GPU is
# reported sooner instead of delaying the next run.
GPU_HEARTBEAT_TIMEOUT=5
# How long the installer waits for the first heartbeat metric before reporting it
# missing. Must comfortably exceed GPU_HEARTBEAT_INTERVAL: the file has to be
# written and then scraped, so the wait is not one interval.
GPU_HEARTBEAT_WAIT=45
# How long a recorded hard freeze keeps raising GpuFreezeDetected, in seconds.
# 2592000 is 30 days. Set to 0 to latch forever until you clear the file by hand.
GPU_HEARTBEAT_MAX_GAP_TTL=2592000

# --- firewall ---------------------------------------------------------------
# 1 opens the port with whichever per-port manager is actually active (firewalld
# or ufw) and changes nothing otherwise. Raw nftables/iptables rulesets are never
# edited, and no setting here can make an application firewall (Portmaster and
# similar) or an upstream router let the port through: the installer reports what
# it found and leaves the rest to you. Set to 0 if the port is already published.
NODE_EXPORTER_FIREWALL_MANAGE=1
NODE_EXPORTER_FIREWALL_PORT=9100/tcp
