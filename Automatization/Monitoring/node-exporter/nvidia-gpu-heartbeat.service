[Unit]
Description=NVIDIA GPU heartbeat for the node_exporter textfile collector
After=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nvidia-gpu-heartbeat
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
