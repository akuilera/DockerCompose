# Peer watchdog -- installer settings.
#
# Copy to peer-watchdog.env next to install-peer-watchdog.sh and edit.
# peer-watchdog.env is loaded first and .env (the shared settings file the
# node_exporter installer also reads) is loaded second, so a peer-only override
# does not require touching the shared file.
#
# Only peer-watchdog.env is loaded by install-peer-watchdog.sh before .env, so if
# both define the same variable the shared .env wins. Keep peer-specific settings
# out of .env.
#
# .env is covered by the repository's ignore rules; peer-watchdog.env has the same
# shape but you should add it there too if you use it, because the only thing in
# it that is machine specific is a path to a local file.
#
# EVERY setting is optional. The defaults are the ones that work on a stock
# systemd Linux next to an existing node_exporter, and this file exists to
# document them rather than to be filled in.

# --- how often ---------------------------------------------------------------
# The interval has to be meaningfully LONGER than the probe timeout below. If the
# interval is shorter, a run can still be waiting on a dead peer when the next
# tick fires, and the history stops being a record of the outage and becomes a
# record of the watcher's own scheduling.
# 60s gives a down window a resolution of at most one minute, which is far finer
# than needed for a freeze that lasts hours.
PEER_WATCHDOG_INTERVAL=60s

# --- probe -------------------------------------------------------------------
# Per-probe wall clock cap, in seconds. This is what stops a peer that accepts the
# connection and then stops sending from holding the run open indefinitely: curl
# gets an explicit --max-time and --connect-timeout, so a dead peer costs exactly
# this much. Lower it if you want a wedged peer reported sooner; raise it only for
# genuinely slow links.
PEER_WATCHDOG_TIMEOUT=5

# How many peers may be probed at the same time. Probing them one at a time is the
# obvious approach and it is wrong: with 10 peers and a 5s timeout, a run where
# everything is down takes 50s, longer than the interval, and the runs then stack.
# The worst case with a pool is ceil(peers / concurrency) * timeout, so the default
# of 8 keeps a 60s interval safe up to about 96 peers.
PEER_WATCHDOG_CONCURRENCY=8

# --- paths -------------------------------------------------------------------
# Where the peer list lives. This file holds the fleet's addresses, so it is
# deliberately OUTSIDE the repository on this machine: the repository ships only
# the template. Nothing personal belongs in a tracked file.
PEER_WATCHDOG_CONFIG=/etc/peer-watchdog/peers.conf

# Per-peer state and the append-only down-window history. The history is the
# point of this whole thing, so put it on whatever disk you would trust to survive
# a reboot of this host.
PEER_WATCHDOG_STATE_DIR=/var/lib/peer-watchdog

# The node_exporter textfile directory, NOT a directory of its own. The metrics
# are served by the node_exporter that already runs here, so Prometheus picks them
# up through the scrape that already happens: no new container, no new port. If
# you change this, node-exporter.service's --collector.textfile.directory has to
# change with it or nothing will ever read these metrics; the installer checks and
# warns.
PEER_WATCHDOG_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# --- retention ---------------------------------------------------------------
# Both limits apply, because each one alone has a failure mode. A period alone
# lets a flapping peer (one short window per minute) grow a file that is expensive
# to rewrite on every run; a line count alone silently discards the history the
# moment the count is reached. Pruning always keeps the NEWEST entries.
# 2592000 is 30 days, which is the project's target window.
PEER_WATCHDOG_HISTORY_RETENTION=2592000
PEER_WATCHDOG_HISTORY_MAX_LINES=5000

# --- service account ---------------------------------------------------------
# Must match the account that owns the textfile directory, which is the
# node_exporter one: the watchdog writes into that directory, so it runs as its
# owner rather than as root.
PEER_WATCHDOG_USER=node_exporter
PEER_WATCHDOG_GROUP=node_exporter

# --- installation paths ------------------------------------------------------
PEER_WATCHDOG_INSTALL_DIR=/usr/local/bin
PEER_WATCHDOG_UNIT_DIR=/etc/systemd/system

# --- verification ------------------------------------------------------------
# How long the installer waits for the first metrics file before reporting it
# missing. Must comfortably exceed PEER_WATCHDOG_INTERVAL: the service has to run,
# write the file, and the exporter has to read it, so this is not one interval.
PEER_WATCHDOG_WAIT=90

# Create a placeholder peer config when none exists. Set to 0 if you manage the
# file yourself. Either way the addresses are yours to fill in locally.
PEER_WATCHDOG_SEED_CONFIG=1

# Only used to scrape the local exporter during verification. Reuses
# NODE_EXPORTER_LISTEN when that is set, so the two installers cannot disagree
# about the port.
PEER_WATCHDOG_LOCAL_LISTEN=:9100