# One file per device, place it on the server inside the repository clone at:
#   ${PATH_TO_COMPOSE}/Automatization/Monitoring/Devices/<device>/.env
# Fill these fields for each monitored machine. See README.md in this folder.
DEVICE_NAME="<device display name>"
DEVICE_ADDR=<ip>:9100
DEVICE_BATTERY=0
DEVICE_GPU=0