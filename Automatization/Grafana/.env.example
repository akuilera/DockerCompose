PATH_TO_CONTAINERS=/path/to/containers/data
PATH_TO_SECRETS=/path/to/secrets
# Absolute path of the repository clone kept on the server. The Grafana and
# Monitoring bootstraps read the scripts and the Devices/ registry from it
# (Portainer CE resolves absolute binds only; ./... from the git clone is empty).
PATH_TO_COMPOSE=/path/to/repository/clone