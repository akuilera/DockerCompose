# Base path where the Docker secret files live, OUTSIDE the git repo.
# It is synced with SyncThing like everything else; never versioned.
PATH_TO_SECRETS=/real/path/to/your/secrets/folder
PATH_TO_CONTAINERS=/real/path/to/your/containers/folder
PATH_TO_DOCUMENTS=/real/path/to/your/documents/folder
# Cloud data: NextCloud and Immich libraries (user files, photo library).
PATH_TO_CLOUD_DATA=/real/path/to/your/cloud/data