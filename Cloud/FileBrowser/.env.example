PATH_TO_CONTAINERS=/path/to/containers
PUID=PUID
PGID=PGID
PATH_TO_SYSTEM_BACKUP=/path/to/system/backup
PATH_TO_DOCUMENTS_BACKUP=/path/to/documents/backup
PATH_TO_DOCUMENTS=/path/to/documents
PATH_TO_SERVER_HOME=/path/to/server/home
# Neutral default; set your real timezone in the local (gitignored) .env,
# never in this file (a Continent/City value reveals your location).
TZ=Etc/UTC